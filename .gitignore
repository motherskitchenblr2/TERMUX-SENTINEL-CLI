# =============================================================================
# Git Ignore for Termux Sentinel
# =============================================================================

# Credentials & Sensitive Configurations
rclone.conf
*.token
*.pem
*.key
.env
.env.*
*.secret

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual Environments
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# Packaging & Build Artifacts
build/
dist/
*.egg-info/
.eggs/

# Testing, Linting & Type Checking
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/

# Static Analysis & Security Scans
results.sarif
*.sarif
bandit.json

# Logs & Runtime Dumps
*.log
test_trace.log
rclone_backup.log
rclone_cmf_backup.log

# Temporary, Backup and Archive Files
*.tmp
*.bak
*.swp
*.swo
*~
*.zip
*.tar.gz
*.7z

# IDE & Editor Settings
.vscode/
.idea/

# OS Metadata
.DS_Store
Thumbs.db
