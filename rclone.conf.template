# =============================================================================
# Rclone Google Drive Configuration Template
# =============================================================================
# How to configure:
# 1. Install rclone: pkg install rclone
# 2. Run: rclone config
#    - Name: remote_gdrive (or update REMOTE name in scripts)
#    - Type: drive
#    - Scope: 1 (Full access)
# 3. Alternatively, copy this file to ~/.config/rclone/rclone.conf
#    and insert your client_id, client_secret, and token.
# 4. Secure the file: chmod 600 ~/.config/rclone/rclone.conf
# =============================================================================

[remote_gdrive]
type = drive
client_id = YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
client_secret = YOUR_GOOGLE_CLIENT_SECRET
scope = drive
token = {"access_token":"YOUR_ACCESS_TOKEN","token_type":"Bearer","refresh_token":"YOUR_REFRESH_TOKEN","expiry":"2026-11-04T00:33:09Z"}
team_drive = 
